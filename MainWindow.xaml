<Window x:Class="BackgroundStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Background Studio"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="#DDE3DF" BorderThickness="0,0,0,1">
      <Grid Margin="26,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Width="42" Height="42" Background="{StaticResource AccentBrush}" CornerRadius="12">
            <TextBlock Text="BG" Foreground="White" FontSize="14" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="12,0,0,0">
            <TextBlock Text="Background Studio" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="내 PC에서 처리하는 이미지·동영상 배경 편집기"
                       Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="ModelStatusDot" Width="9" Height="9" Fill="#C89000" />
          <TextBlock x:Name="ModelStatusText" Text="모델 확인 중" Margin="7,0,14,0"
                     VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
          <Button x:Name="DownloadModelButton" Content="모델 준비" Click="DownloadModel_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="1. 원본 선택" FontSize="17" FontWeight="Bold" Margin="0,0,0,12" />
              <UniformGrid Columns="2">
                <Button Content="이미지 열기" Margin="0,0,5,0" Click="OpenImage_Click" />
                <Button Content="동영상 열기" Margin="5,0,0,0" Click="OpenVideo_Click" />
              </UniformGrid>
              <TextBlock x:Name="SourceNameText" Text="선택한 파일이 없습니다."
                         Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                         Margin="0,12,0,0" />
            </StackPanel>
          </Border>

          <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="2. 배경 편집" FontSize="17" FontWeight="Bold" Margin="0,0,0,12" />
              <TextBlock Text="결과 배경" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
              <ComboBox x:Name="ModeCombo" SelectionChanged="ModeCombo_SelectionChanged" SelectedIndex="0">
                <ComboBoxItem Content="투명 PNG / WebM" Tag="Transparent" />
                <ComboBoxItem Content="단색 배경" Tag="Color" />
                <ComboBoxItem Content="다른 이미지" Tag="Image" />
                <ComboBoxItem Content="원본 블러" Tag="Blur" />
              </ComboBox>

              <StackPanel x:Name="ColorPanel" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Text="배경 색상" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                <TextBox x:Name="ColorText" Text="#FFFFFF" />
              </StackPanel>
              <StackPanel x:Name="BackgroundPanel" Margin="0,12,0,0" Visibility="Collapsed">
                <Button Content="배경 이미지 선택" Click="OpenBackground_Click" />
                <TextBlock x:Name="BackgroundNameText" Text="선택하지 않음"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
              </StackPanel>
              <StackPanel x:Name="BlurPanel" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Text="블러 강도" Foreground="{StaticResource MutedBrush}" />
                <Slider x:Name="BlurSlider" Minimum="0" Maximum="50" Value="18" TickFrequency="1" />
              </StackPanel>

              <TextBlock Text="마스크 기준" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" />
              <Slider x:Name="ThresholdSlider" Minimum="0" Maximum="1" Value="0.45" TickFrequency="0.05" />
              <TextBlock Text="가장자리 부드러움" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
              <Slider x:Name="SoftnessSlider" Minimum="0" Maximum="0.6" Value="0.18" TickFrequency="0.02" />

              <Expander Header="그림자 옵션" Margin="0,12,0,0">
                <StackPanel Margin="0,8,0,0">
                  <TextBlock Text="흐림" Foreground="{StaticResource MutedBrush}" />
                  <Slider x:Name="ShadowBlurSlider" Minimum="0" Maximum="50" Value="0" />
                  <TextBlock Text="불투명도" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                  <Slider x:Name="ShadowOpacitySlider" Minimum="0" Maximum="1" Value="0.35" />
                  <TextBlock Text="세로 오프셋" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                  <Slider x:Name="ShadowYSlider" Minimum="-50" Maximum="50" Value="12" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>

          <Button x:Name="ProcessButton" Content="3. 배경 제거 시작"
                  Style="{StaticResource PrimaryButton}" Click="Process_Click"
                  IsEnabled="False" />
          <Button x:Name="CancelButton" Content="작업 취소" Margin="0,8,0,0"
                  Click="Cancel_Click" Visibility="Collapsed" />
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="2" Background="{StaticResource CanvasBrush}" CornerRadius="18" Padding="20">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="미리보기" FontSize="17" FontWeight="Bold" />
            <Button x:Name="SaveButton" Content="PNG 저장" HorizontalAlignment="Right"
                    Padding="16,7" MinHeight="36" Click="Save_Click" IsEnabled="False" />
          </Grid>
          <Border Grid.Row="1" Margin="0,16,0,0" Background="White" CornerRadius="14"
                  BorderBrush="#D9DFDB" BorderThickness="1">
            <Grid>
              <Image x:Name="PreviewImage" Stretch="Uniform" Margin="16" />
              <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="이미지나 동영상을 선택하세요" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="첫 실행에서는 약 5MB 모델을 내려받습니다."
                           Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="#DDE3DF" BorderThickness="0,1,0,0">
      <Grid Margin="24,12">
        <ProgressBar x:Name="ProgressBar" Height="7" Minimum="0" Maximum="1" Value="0" />
        <TextBlock x:Name="StatusText" Text="준비" Margin="0,12,0,0"
                   Foreground="{StaticResource MutedBrush}" />
      </Grid>
    </Border>
  </Grid>
</Window>
