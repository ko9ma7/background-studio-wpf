<Window x:Class="BackgroundStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Background Studio"
        Width="1440"
        Height="860"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="#DDE3DF" BorderThickness="0,0,0,1">
      <Grid Margin="24,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Width="42" Height="42" Background="{StaticResource AccentBrush}" CornerRadius="12">
            <TextBlock Text="BG" Foreground="White" FontSize="14" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="12,0,0,0">
            <TextBlock Text="Background Studio" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="대기열로 처리하고 결과를 자동 저장하는 로컬 이미지·동영상 편집기"
                       Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="ModelStatusDot" Width="9" Height="9" Fill="#C89000" />
          <TextBlock x:Name="ModelStatusText" Text="모델 확인 중" Margin="7,0,10,0"
                     VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
          <Button x:Name="DownloadModelButton" Content="모델 준비" Click="DownloadModel_Click" />
          <Border Width="1" Height="24" Background="#DDE3DF" Margin="10,0" />
          <Ellipse x:Name="FfmpegStatusDot" Width="9" Height="9" Fill="#C89000" />
          <TextBlock x:Name="FfmpegStatusText" Text="FFmpeg 확인 중" Margin="7,0,10,0"
                     VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
          <Button x:Name="DownloadFfmpegButton" Content="FFmpeg 준비" Click="DownloadFfmpeg_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="310" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="작업 대기열" FontSize="17" FontWeight="Bold" />
            <TextBlock Text="여러 파일을 넣고 한 번에 순차 처리합니다." Margin="0,4,0,12"
                       Foreground="{StaticResource MutedBrush}" FontSize="12" />
            <UniformGrid Columns="2">
              <Button x:Name="OpenImageButton" Content="이미지 추가" Margin="0,0,4,0" Click="OpenImage_Click" />
              <Button x:Name="OpenVideoButton" Content="동영상 추가" Margin="4,0,0,0" Click="OpenVideo_Click" />
            </UniformGrid>
            <UniformGrid Columns="2" Margin="0,8,0,12">
              <Button x:Name="RemoveSelectedButton" Content="선택 삭제" Margin="0,0,4,0" Click="RemoveSelected_Click" />
              <Button x:Name="ClearQueueButton" Content="전체 초기화" Margin="4,0,0,0" Click="ClearQueue_Click" />
            </UniformGrid>
          </StackPanel>

          <ListBox x:Name="QueueList" Grid.Row="1" SelectionChanged="QueueList_SelectionChanged"
                   BorderThickness="0" Background="Transparent"
                   VirtualizingStackPanel.IsVirtualizing="True"
                   VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="10" Margin="0,0,0,7" CornerRadius="10" BorderBrush="#DDE3DF" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Status}" Margin="0,3,0,5" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <ProgressBar Height="5" Minimum="0" Maximum="1" Value="{Binding Progress}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="ProcessButton" Content="대기열 전체 변환" Style="{StaticResource PrimaryButton}"
                    Click="Process_Click" IsEnabled="False" />
            <Button x:Name="RequeueButton" Content="선택 작업 다시 대기" Margin="0,8,0,0"
                    Click="Requeue_Click" />
            <Button x:Name="CancelButton" Content="현재 처리 취소" Margin="0,8,0,0"
                    Click="Cancel_Click" Visibility="Collapsed" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource CanvasBrush}" CornerRadius="18" Padding="18">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel>
              <TextBlock Text="미리보기" FontSize="17" FontWeight="Bold" />
              <TextBlock x:Name="SourceNameText" Text="대기열에서 파일을 선택하세요."
                         Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Content="출력 폴더 열기" HorizontalAlignment="Right" Padding="16,7"
                    MinHeight="36" Click="OpenOutputFolder_Click" />
          </Grid>
          <Border Grid.Row="1" Margin="0,14,0,0" Background="White" CornerRadius="14"
                  BorderBrush="#D9DFDB" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <WrapPanel Margin="9,8,9,7" VerticalAlignment="Center">
                <Button Content="−" Width="34" Click="ZoomOut_Click" />
                <TextBlock x:Name="ZoomText" Text="맞춤" Width="58"
                           TextAlignment="Center" VerticalAlignment="Center" />
                <Button Content="+" Width="34" Click="ZoomIn_Click" />
                <Button Content="맞춤" Margin="6,0,0,0" Click="FitPreview_Click" />
                <Button Content="100%" Margin="4,0,0,0" Click="ActualSize_Click" />
                <Button x:Name="HandToolButton" Content="손" Margin="12,0,0,0"
                        Click="HandTool_Click" />
                <Button x:Name="EraseToolButton" Content="지우기" Margin="4,0,0,0"
                        Click="EraseTool_Click" />
                <Button x:Name="RestoreToolButton" Content="복원" Margin="4,0,0,0"
                        Click="RestoreTool_Click" />
                <TextBlock Text="브러시" Margin="12,0,4,0" VerticalAlignment="Center" />
                <Slider x:Name="BrushSizeSlider" Width="90" Minimum="4" Maximum="160"
                        Value="36" VerticalAlignment="Center" />
                <Button x:Name="UndoMaskButton" Content="마스크 실행 취소" Margin="7,0,0,0"
                        Click="UndoMask_Click" IsEnabled="False" />
              </WrapPanel>
              <Grid x:Name="PreviewHost"
                    Grid.Row="1"
                    Margin="10,0,10,10"
                    Background="{StaticResource CanvasBrush}"
                    ClipToBounds="True"
                    MouseWheel="PreviewHost_MouseWheel"
                    MouseLeftButtonDown="PreviewHost_MouseLeftButtonDown"
                    MouseLeftButtonUp="PreviewHost_MouseLeftButtonUp"
                    MouseMove="PreviewHost_MouseMove"
                    MouseDown="PreviewHost_MouseDown"
                    MouseUp="PreviewHost_MouseUp"
                    SizeChanged="PreviewHost_SizeChanged">
                <Image x:Name="PreviewImage" Stretch="Uniform">
                  <Image.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1" />
                      <TranslateTransform x:Name="PreviewTranslate" />
                    </TransformGroup>
                  </Image.RenderTransform>
                </Image>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="이미지나 동영상을 대기열에 추가하세요" FontSize="19" FontWeight="SemiBold"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="처리 완료 결과는 자동으로 출력 폴더에 저장됩니다."
                             Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                </StackPanel>
              </Grid>
              <Border x:Name="HistoryPanel"
                      Grid.Row="2"
                      Margin="10,0,10,10"
                      Padding="10"
                      CornerRadius="12"
                      BorderBrush="#B7C9BF"
                      BorderThickness="1"
                      Background="#F4FFFEFA"
                      Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="편집 히스토리" FontWeight="Bold" FontSize="12" />
                    <TextBlock Text="분리 원본 기준 · 클릭해서 비교"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10" />
                  </StackPanel>
                  <ListBox x:Name="HistoryList"
                           Grid.Column="1"
                           Height="46"
                           BorderThickness="0"
                           Background="Transparent"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           SelectionChanged="HistoryList_SelectionChanged">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                        <Setter Property="Padding" Value="11,7" />
                        <Setter Property="Margin" Value="0,0,6,0" />
                        <Setter Property="Background" Value="White" />
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Setter Property="BorderBrush" Value="#D9DFDB" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <Border Padding="{TemplateBinding Padding}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="9">
                                <ContentPresenter />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                  <Setter Property="Foreground" Value="White" />
                                  <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="14">
        <TabControl x:Name="EditorTabs"
                    SelectionChanged="EditorTabs_SelectionChanged"
                    PreviewMouseUp="EditorTabs_PreviewMouseUp"
                    PreviewKeyUp="EditorTabs_PreviewKeyUp"
                    LostKeyboardFocus="EditorTabs_LostKeyboardFocus">
          <TabItem Header="배경">
            <StackPanel Margin="8,14,8,8">
              <TextBlock Text="결과 배경" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
              <ComboBox x:Name="ModeCombo" SelectionChanged="ModeCombo_SelectionChanged" SelectedIndex="0">
                <ComboBoxItem Content="투명 배경" Tag="Transparent" />
                <ComboBoxItem Content="단색 배경" Tag="Color" />
                <ComboBoxItem Content="다른 이미지" Tag="Image" />
                <ComboBoxItem Content="원본 블러" Tag="Blur" />
              </ComboBox>
              <StackPanel x:Name="ColorPanel" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Text="배경 색상" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                <TextBox x:Name="ColorText" Text="#FFFFFF" />
              </StackPanel>
              <StackPanel x:Name="BackgroundPanel" Margin="0,12,0,0" Visibility="Collapsed">
                <Button Content="배경 이미지 선택" Click="OpenBackground_Click" />
                <TextBlock x:Name="BackgroundNameText" Text="선택하지 않음"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
              </StackPanel>
              <StackPanel x:Name="BlurPanel" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Text="블러 강도" Foreground="{StaticResource MutedBrush}" />
                <Slider x:Name="BlurSlider" Minimum="0" Maximum="50" Value="18" TickFrequency="1" />
              </StackPanel>
              <TextBlock Text="그림자 흐림" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0" />
              <Slider x:Name="ShadowBlurSlider" Minimum="0" Maximum="50" Value="0" />
              <TextBlock Text="그림자 불투명도" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
              <Slider x:Name="ShadowOpacitySlider" Minimum="0" Maximum="1" Value="0.35" />
              <TextBlock Text="그림자 세로 위치" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
              <Slider x:Name="ShadowYSlider" Minimum="-50" Maximum="50" Value="12" />
              <TextBlock Text="그림자 가로 위치" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
              <Slider x:Name="ShadowXSlider" Minimum="-50" Maximum="50" Value="0" />
            </StackPanel>
          </TabItem>

          <TabItem Header="필터·외곽">
            <StackPanel Margin="8,14,8,8">
              <TextBlock Text="피사체 필터" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
              <ComboBox x:Name="FilterCombo" SelectedIndex="0">
                <ComboBoxItem Content="원본" Tag="Original" />
                <ComboBoxItem Content="밝게" Tag="Bright" />
                <ComboBoxItem Content="선명하게" Tag="Vivid" />
                <ComboBoxItem Content="따뜻하게" Tag="Warm" />
                <ComboBoxItem Content="차갑게" Tag="Cool" />
                <ComboBoxItem Content="흑백" Tag="Grayscale" />
                <ComboBoxItem Content="코믹 하이라이트" Tag="Comic" />
                <ComboBoxItem Content="고대비" Tag="HighContrast" />
                <ComboBoxItem Content="포스터 컬러" Tag="Posterize" />
                <ComboBoxItem Content="세피아" Tag="Sepia" />
                <ComboBoxItem Content="네거티브" Tag="Invert" />
                <ComboBoxItem Content="연필 스케치" Tag="Pencil" />
              </ComboBox>
              <TextBlock Text="출력 레이어" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,5" />
              <ComboBox x:Name="RenderModeCombo" SelectedIndex="0"
                        SelectionChanged="RenderModeCombo_SelectionChanged">
                <ComboBoxItem Content="완성 합성" Tag="Composite" />
                <ComboBoxItem Content="흑백 마스크" Tag="Mask" />
                <ComboBoxItem Content="외곽선만" Tag="Outline" />
              </ComboBox>
              <StackPanel x:Name="OutlinePanel" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Text="외곽선 두께" Foreground="{StaticResource MutedBrush}" />
                <Slider x:Name="OutlineWidthSlider" Minimum="1" Maximum="12" Value="3" TickFrequency="1" />
                <TextBlock Text="외곽선 색상" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4" />
                <TextBox x:Name="OutlineColorText" Text="#111111" />
              </StackPanel>
              <TextBlock Text="마스크 기준" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0" />
              <Slider x:Name="ThresholdSlider" Minimum="0" Maximum="1" Value="0.45" TickFrequency="0.05" />
              <TextBlock Text="가장자리 부드러움" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
              <Slider x:Name="SoftnessSlider" Minimum="0" Maximum="0.6" Value="0.18" TickFrequency="0.02" />
              <TextBlock Margin="0,16,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                         Text="외곽선만 + SVG를 선택하면 포토샵 패스처럼 편집 가능한 벡터 경계를 저장합니다." />
            </StackPanel>
          </TabItem>

          <TabItem Header="위치·크기">
            <StackPanel Margin="8,14,8,8">
              <CheckBox x:Name="AutoCenterCheck" Content="피사체 자동 중앙 정렬" IsChecked="True" />
              <TextBlock Text="크기" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" />
              <Slider x:Name="SubjectScaleSlider" Minimum="0.3" Maximum="2" Value="1" TickFrequency="0.1" />
              <TextBlock Text="가로 위치" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
              <Slider x:Name="SubjectXSlider" Minimum="-0.5" Maximum="0.5" Value="0" TickFrequency="0.05" />
              <TextBlock Text="세로 위치" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
              <Slider x:Name="SubjectYSlider" Minimum="-0.5" Maximum="0.5" Value="0" TickFrequency="0.05" />
              <TextBlock Text="회전" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
              <Slider x:Name="RotationSlider" Minimum="-180" Maximum="180" Value="0" TickFrequency="1" />
              <UniformGrid Columns="2" Margin="0,12,0,0">
                <CheckBox x:Name="FlipHorizontalCheck" Content="좌우 반전" />
                <CheckBox x:Name="FlipVerticalCheck" Content="상하 반전" />
              </UniformGrid>
              <TextBlock Text="캔버스 비율" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,5" />
              <ComboBox x:Name="CanvasAspectCombo" SelectedIndex="0">
                <ComboBoxItem Content="원본 비율" Tag="Original" />
                <ComboBoxItem Content="정사각형 1:1" Tag="Square" />
                <ComboBoxItem Content="세로형 4:5" Tag="Portrait45" />
                <ComboBoxItem Content="가로형 16:9" Tag="Landscape169" />
              </ComboBox>
              <TextBlock Margin="0,18,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                         Text="자동 중앙 정렬 후 크기와 가로·세로 위치를 조절하면 이미지와 모든 영상 프레임에 같은 구도가 적용됩니다." />
            </StackPanel>
          </TabItem>

          <TabItem Header="고급">
            <StackPanel Margin="8,14,8,8">
              <TextBlock Text="밝기" Foreground="{StaticResource MutedBrush}" />
              <Slider x:Name="BrightnessSlider" Minimum="0.2" Maximum="2" Value="1" TickFrequency="0.05" />
              <TextBlock Text="대비" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
              <Slider x:Name="ContrastSlider" Minimum="0.2" Maximum="2" Value="1" TickFrequency="0.05" />
              <TextBlock Text="채도" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
              <Slider x:Name="SaturationSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.05" />
              <TextBlock Text="색온도" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
              <Slider x:Name="TemperatureSlider" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.05" />
              <TextBlock Text="색조 회전" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
              <Slider x:Name="HueSlider" Minimum="-180" Maximum="180" Value="0" TickFrequency="1" />
              <TextBlock Text="피사체 불투명도" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
              <Slider x:Name="ForegroundOpacitySlider" Minimum="0" Maximum="1" Value="1" TickFrequency="0.05" />
              <TextBlock Text="마스크 확장 / 축소" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
              <Slider x:Name="MaskExpansionSlider" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" />
            </StackPanel>
          </TabItem>

          <TabItem Header="저장·결과">
            <Grid Margin="8,14,8,8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="이미지 저장 형식" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                <ComboBox x:Name="ImageFormatCombo" SelectedIndex="0">
                  <ComboBoxItem Content="PNG" Tag="png" />
                  <ComboBoxItem Content="JPEG" Tag="jpg" />
                  <ComboBoxItem Content="BMP" Tag="bmp" />
                  <ComboBoxItem Content="TIFF" Tag="tiff" />
                  <ComboBoxItem Content="SVG 외곽 패스" Tag="svg" />
                </ComboBox>
                <TextBlock Text="동영상 저장 형식" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5" />
                <ComboBox x:Name="VideoFormatCombo" SelectedIndex="0">
                  <ComboBoxItem Content="WebM (투명 지원)" Tag="webm" />
                  <ComboBoxItem Content="MOV (알파 지원)" Tag="mov" />
                  <ComboBoxItem Content="MP4" Tag="mp4" />
                  <ComboBoxItem Content="GIF" Tag="gif" />
                </ComboBox>
                <TextBlock x:Name="OutputFolderText" Margin="0,12,0,10" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" FontSize="11" />
              </StackPanel>
              <ListBox x:Name="ResultsList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                       SelectionChanged="ResultsList_SelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding OutputPath}" Foreground="{StaticResource MutedBrush}"
                                 FontSize="10" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <UniformGrid Grid.Row="2" Columns="2" Margin="0,10,0,0">
                <Button Content="선택 결과 열기" Margin="0,0,4,0" Click="OpenSelectedResult_Click" />
                <Button Content="폴더 열기" Margin="4,0,0,0" Click="OpenOutputFolder_Click" />
              </UniformGrid>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="#DDE3DF" BorderThickness="0,1,0,0">
      <Grid Margin="20,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ProgressBar x:Name="ProgressBar" Height="6" Minimum="0" Maximum="1" Value="0" />
        <TextBlock x:Name="StatusText" Grid.Row="1" Text="준비 · 완료 결과는 자동 저장됩니다." Margin="0,7,0,0"
                   Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
  </Grid>
</Window>
