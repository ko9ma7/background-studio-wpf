<Application x:Class="BackgroundStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="App_Startup">
  <Application.Resources>
    <Color x:Key="InkColor">#171A1D</Color>
    <Color x:Key="MutedColor">#66706A</Color>
    <Color x:Key="AccentColor">#03C75A</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="CanvasColor">#EEF1EF</Color>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />

    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="Background" Value="#F5F7F6" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="#E7ECE9" />
      <Setter Property="BorderBrush" Value="#CDD5D0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Border" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Border" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="BorderBrush" Value="#CDD5D0" />
    </Style>
    <Style TargetType="Slider">
      <Setter Property="MinHeight" Value="32" />
    </Style>
  </Application.Resources>
</Application>
